<% const activePage = 'grades'; %>
<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container py-4" style="max-width:640px">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-pencil me-2 text-warning"></i>Enter Grade</h2>
    <a href="/grades" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i>Back
    </a>
  </div>

  <%- include('../partials/alerts') %>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <form action="/grades" method="POST" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="mb-3">
          <label class="form-label fw-semibold">Student <span class="text-danger">*</span></label>
          <select class="form-select" name="student_id" required>
            <option value="">-- Select student --</option>
            <% students.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.name %> (<%= s.student_id %> — <%= s.class_name %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Course <span class="text-danger">*</span></label>
          <select class="form-select" name="course_id" required>
            <option value="">-- Select course --</option>
            <% courses.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %> (<%= c.code %> — <%= c.class_name %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Term <span class="text-danger">*</span></label>
            <select class="form-select" name="term" required>
              <option value="">-- Select term --</option>
              <% terms.forEach(t => { %>
                <option value="<%= t %>"><%= t %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Year <span class="text-danger">*</span></label>
            <select class="form-select" name="year" required>
              <option value="">-- Select year --</option>
              <% years.forEach(y => { %>
                <option value="<%= y %>"><%= y %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Marks Obtained <span class="text-danger">*</span></label>
            <input type="number" class="form-control" name="marks" min="0" step="0.5" placeholder="e.g. 75" required />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Maximum Marks</label>
            <input type="number" class="form-control" name="max_marks" min="1" value="100" step="1" />
          </div>
        </div>
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-warning px-4 fw-semibold">
            <i class="bi bi-save me-2"></i>Save Grade
          </button>
          <a href="/grades" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
