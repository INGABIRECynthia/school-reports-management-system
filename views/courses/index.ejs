<% const activePage = 'courses'; %>
<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-book me-2 text-success"></i>Courses</h2>
    <a href="/courses/new" class="btn btn-success">
      <i class="bi bi-plus-circle me-2"></i>Add Course
    </a>
  </div>

  <%- include('../partials/alerts') %>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <% if (courses.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-book fs-1 d-block mb-2"></i>
          No courses found. <a href="/courses/new">Add the first course</a>.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Class</th>
                <th>Teacher</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% courses.forEach(c => { %>
                <tr>
                  <td><span class="badge bg-success"><%= c.code %></span></td>
                  <td class="fw-semibold"><%= c.name %></td>
                  <td><%= c.class_name %></td>
                  <td><% if (c.teacher_name) { %><%= c.teacher_name %><% } else { %><span class="text-muted">Unassigned</span><% } %></td>
                  <td class="text-end">
                    <a href="/courses/<%= c.id %>/edit" class="btn btn-sm btn-outline-primary me-1">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/courses/<%= c.id %>?_method=DELETE" method="POST" class="d-inline"
                          onsubmit="return confirm('Delete course <%= c.name %>?')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
