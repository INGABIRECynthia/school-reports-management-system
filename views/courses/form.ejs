<% const activePage = 'courses'; %>
<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container py-4" style="max-width:600px">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
      <i class="bi bi-book me-2 text-success"></i>
      <%= course ? 'Edit Course' : 'Add Course' %>
    </h2>
    <a href="/courses" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i>Back
    </a>
  </div>

  <%- include('../partials/alerts') %>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <form action="/courses<%= course ? '/' + course.id + '?_method=PUT' : '' %>" method="POST" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="mb-3">
          <label class="form-label fw-semibold">Course Code <span class="text-danger">*</span></label>
          <input type="text" class="form-control text-uppercase" name="code"
                 value="<%= course ? course.code : '' %>" placeholder="e.g. MATH1" required />
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Course Name <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="name"
                 value="<%= course ? course.name : '' %>" placeholder="e.g. Mathematics" required />
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Class <span class="text-danger">*</span></label>
          <select class="form-select" name="class_name" required>
            <option value="">-- Select class --</option>
            <% ['Form 1','Form 2','Form 3','Form 4','Form 5','Form 6'].forEach(c => { %>
              <option value="<%= c %>" <%= course && course.class_name === c ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-4">
          <label class="form-label fw-semibold">Assigned Teacher</label>
          <select class="form-select" name="teacher_id">
            <option value="">-- None --</option>
            <% teachers.forEach(t => { %>
              <option value="<%= t.id %>" <%= course && course.teacher_id === t.id ? 'selected' : '' %>><%= t.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-success px-4">
            <i class="bi bi-save me-2"></i><%= course ? 'Update' : 'Add' %> Course
          </button>
          <a href="/courses" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
