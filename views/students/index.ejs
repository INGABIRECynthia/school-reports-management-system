<% const activePage = 'students'; %>
<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-people me-2 text-primary"></i>Students</h2>
    <a href="/students/new" class="btn btn-primary">
      <i class="bi bi-person-plus me-2"></i>Add Student
    </a>
  </div>

  <%- include('../partials/alerts') %>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <% if (students.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-people fs-1 d-block mb-2"></i>
          No students found. <a href="/students/new">Add the first student</a>.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Student ID</th>
                <th>Name</th>
                <th>Class</th>
                <th>Academic Year</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach(s => { %>
                <tr>
                  <td><span class="badge bg-secondary"><%= s.student_id %></span></td>
                  <td class="fw-semibold"><%= s.name %></td>
                  <td><%= s.class_name %></td>
                  <td><%= s.year %></td>
                  <td class="text-end">
                    <a href="/students/<%= s.id %>/edit" class="btn btn-sm btn-outline-primary me-1">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/students/<%= s.id %>?_method=DELETE" method="POST" class="d-inline"
                          onsubmit="return confirm('Delete <%= s.name %>?')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
