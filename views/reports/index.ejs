<% const activePage = 'reports'; %>
<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container py-4" style="max-width:680px">
  <div class="mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-file-earmark-bar-graph me-2 text-info"></i>Generate Report</h2>
    <p class="text-muted">Select filters to generate a student report card.</p>
  </div>

  <%- include('../partials/alerts') %>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <form method="GET" action="/reports/generate" novalidate>
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Class <span class="text-danger">*</span></label>
            <select class="form-select" name="class_name" required>
              <option value="">-- Select class --</option>
              <% classes.forEach(c => { %>
                <option value="<%= c %>"><%= c %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Term <span class="text-danger">*</span></label>
            <select class="form-select" name="term" required>
              <option value="">-- Select term --</option>
              <% terms.forEach(t => { %>
                <option value="<%= t %>"><%= t %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Academic Year <span class="text-danger">*</span></label>
            <select class="form-select" name="year" required>
              <option value="">-- Select year --</option>
              <% years.forEach(y => { %>
                <option value="<%= y %>"><%= y %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Student (optional)</label>
            <select class="form-select" name="student_id">
              <option value="">All students</option>
            </select>
            <div class="form-text">Leave blank to report all students in the class.</div>
          </div>
        </div>
        <div class="d-grid mt-4">
          <button type="submit" class="btn btn-info btn-lg fw-semibold text-white">
            <i class="bi bi-file-earmark-text me-2"></i>Generate Report
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
