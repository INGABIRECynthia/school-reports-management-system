# Copy this file to .env and fill in the values for production use.

# Express session secret — use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-secret

# CSRF secret — use a different long random string in production
CSRF_SECRET=change-me-to-another-long-random-secret

# Port the server listens on (default: 3000)
PORT=3000

# Initial admin account password (only used on first run when no admin exists)
ADMIN_PASSWORD=admin123
